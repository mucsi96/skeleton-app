{
  "version": "2.0.0",
  "tasks": [
    { "label": "Start DB Connection Proxy", "type": "shell", "command": "scripts/start_db_proxy.sh", "isBackground": true, "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": [] },
    { "label": "Encrypt vault", "type": "shell", "command": "${command:python.interpreterPath} -m ansible.cli.vault encrypt vars/vault.yaml --vault-password-file .ansible/vault_key", "isBackground": true, "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": [] },
    { "label": "Decrypt vault", "type": "shell", "command": "${command:python.interpreterPath} -m ansible.cli.vault decrypt vars/vault.yaml --vault-password-file .ansible/vault_key", "isBackground": true, "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": [] },
    { "label": "View vault", "type": "shell", "command": "${command:python.interpreterPath} -m ansible.cli.vault view vars/vault.yaml --vault-password-file .ansible/vault_key", "isBackground": true, "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": [] },
    { "label": "Start client", "type": "shell", "command": "npm start", "options": { "cwd": "${workspaceFolder}/client" }, "problemMatcher": [] },
    { "label": "Build server", "type": "shell", "command": "cargo build --locked", "options": { "cwd": "${workspaceFolder}/server" }, "problemMatcher": ["$rustc"] },
    { "label": "Install dependencies", "type": "shell", "command": "scripts/install_dependencies.sh", "problemMatcher": [] },
    { "label": "Pod up", "type": "shell", "command": "scripts/pod_up.sh", "problemMatcher": [] },
    { "label": "Pod down", "type": "shell", "command": "scripts/pod_down.sh", "problemMatcher": [] },
    { "label": "Dev DB up", "type": "shell", "command": "scripts/dev_db_up.sh", "problemMatcher": [] },
    { "label": "Dev DB down", "type": "shell", "command": "scripts/dev_db_down.sh", "problemMatcher": [] },
    { "label": "Deploy", "type": "shell", "command": "scripts/deploy.sh", "problemMatcher": [] },
    { "label": "Run Playwright Tests", "type": "shell", "command": "npm test", "options": { "cwd": "${workspaceFolder}/test" }, "problemMatcher": [], "group": { "kind": "test", "isDefault": true } }
  ]
}
