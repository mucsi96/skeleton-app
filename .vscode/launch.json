{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start mock AI server",
      "request": "launch",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/mock_anthropic_server",
      "runtimeArgs": [
        "start"
      ],
      "runtimeExecutable": "npm",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "node"
    },
    {
      "type": "lldb",
      "name": "Start server",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "args": ["start", "--no-banner"],
      "cargo": { "args": ["build", "--bin", "skeleton-server", "--manifest-path", "${workspaceFolder}/server/Cargo.toml"] },
      "env": {
        "LOCO_ENV": "development",
        "PORT": "8053",
        "DATABASE_URL": "postgres://postgres:postgres@localhost:5450/skeleton",
        "OIDC_ISSUER": "http://localhost:8050/default",
        "API_CLIENT_ID": "mock-api-client-id",
        "ANTHROPIC_BASE_URL": "http://localhost:3050",
        "ANTHROPIC_API_KEY": "mock-anthropic-key"
      }
    }
  ]
}
